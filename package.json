{
  "name": "opencode-multikey",
  "version": "0.1.1",
  "description": "Multi-key credential failover for OpenCode V2 providers, including OpenCode Go.",
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./src/index.ts",
    "./tui": "./src/tui.tsx",
    "./rpc": "./src/rpc.ts"
  },
  "files": [
    "src",
    "README.md",
    "INSTALL.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": [
    "opencode",
    "opencode-plugin",
    "opencode-go",
    "credentials",
    "failover",
    "multi-account"
  ],
  "dependencies": {
    "@opencode/plugin": "^2.1.3"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.6.6",
    "@opentui/solid": ">=0.6.6",
    "solid-js": ">=1.9.0"
  },
  "devDependencies": {
    "@opencode/theme": "2.1.4",
    "@opentui/core": "^0.6.8",
    "@opentui/solid": "^0.6.8",
    "@types/bun": "latest",
    "solid-js": "1.9.12",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "check": "bun run typecheck && bun test"
  }
}
